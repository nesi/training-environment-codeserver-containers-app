#!/usr/bin/env bash

# send all output to pod.log
exec &> >(tee -a "${LOG_DIR}/pod.log")

echo "TIMING - Starting main script at: $(date)"

# Set working directory to home directory
cd "${HOME}"

set -x

# apptainer settings
# - the cache lives in the home directory so pulled images are still there when
#   the session is restarted
# - the build/tmp directory is local to the pod, building on the NFS home
#   directory is slow and can fail
# these are exported before code-server starts, so its terminals inherit them
export APPTAINER_CACHEDIR="${HOME}/.apptainer/cache"
export APPTAINER_TMPDIR="/tmp/apptainer-${USER}"
mkdir -p "${APPTAINER_CACHEDIR}" "${APPTAINER_TMPDIR}"

apptainer --version

CODE_SERVER_DATAROOT="${HOME}/.local/share/code-server"
mkdir -p "${CODE_SERVER_DATAROOT}/extensions"

echo "TIMING - Starting code-server at: $(date)"

code-server \
    --auth="password" \
    --bind-addr="0.0.0.0:8443" \
    --disable-telemetry \
    --user-data-dir="${CODE_SERVER_DATAROOT}" \
    --extensions-dir="${CODE_SERVER_DATAROOT}/extensions" \
    --log debug \
    "${HOME}/containers-workshop"
